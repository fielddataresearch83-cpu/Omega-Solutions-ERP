# ─────────────────────────────────────────────────────────────
# Omega Solutions — Backend Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholder values
# with your real credentials. NEVER commit .env to git.

# PostgreSQL connection string.
# When using Supabase, this is the SUPABASE_DB_URL value from your project.
# Format: postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# Optional Upstash Redis cache (development only).
# Use the rediss:// connection URL from Upstash; the API uses its HTTPS REST endpoint.
# REDIS_URL=rediss://default:YOUR_TOKEN@YOUR_DATABASE.upstash.io:6379

# JWT secrets for authentication tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These MUST be set — the app will not start without valid secrets.
JWT_SECRET=replace-with-a-64-byte-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-64-byte-hex-string

# Neon Auth identity verification (development/testing branch only).
NEON_AUTH_BASE_URL=https://ep-fragrant-bird-b4hie5sp.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-fragrant-bird-b4hie5sp.neonauth.c-6.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# JWT expiration times (optional — defaults shown)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server port (optional — default 3000)
PORT=3000

# Frontend origin for CORS (your frontend URL; use localhost for local dev)
CORS_ORIGIN=http://localhost:5173

# S3-compatible persistent object storage for product photos (development only).
# Create the private "uploads" bucket in your object-storage provider and configure
# credentials restricted to that bucket. Never use production storage credentials here.
AWS_ACCESS_KEY_ID=replace-with-development-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-development-storage-secret-key
AWS_ENDPOINT_URL_S3=https://your-development-object-storage-endpoint
AWS_REGION=auto


# Paystack subscription checkout — DEVELOPMENT TEST MODE ONLY.
# Set only on the development API service. Use the Paystack TEST secret key
# (sk_test_...) from Dashboard → Settings → API Keys & Webhooks.
# Never commit real keys or use live keys on the development API.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret_key
# Optional: URL for the browser redirect after checkout. The webhook endpoint
# must separately be registered in Paystack as:
# https://YOUR-DEVELOPMENT-API/api/subscriptions/paystack/webhook
PAYSTACK_CALLBACK_URL=https://YOUR-DEVELOPMENT-FRONTEND/settings/billing
